# syntax=docker/dockerfile:1.4

# ==============================================================================
# Dexta Africa Enterprise Admin Portal - Development Container Dockerfile
# Optimized for Live Hot Reloading (HMR), Prisma Introspection, and Fast Iteration
# Uses Debian Slim (glibc) for 100% reliable DNS on macOS & native Prisma engines
# ==============================================================================

FROM node:20-slim

# Install OpenSSL for Prisma engine & CA certificates
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Enable Next.js hot reloading inside container environments (macOS / Windows / Linux)
ENV NODE_ENV=development
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1
ENV WATCHPACK_POLLING=true
ENV CHOKIDAR_USEPOLLING=true

# Copy package manifests for deterministic dependency caching
COPY package.json package-lock.json ./
COPY prisma ./prisma/

# Install full dependencies including devDependencies (TypeScript, Tailwind, Prisma CLI)
RUN npm install

# Copy application source code
COPY . .

# Generate initial Prisma client bindings
RUN npx prisma generate

# Create persistent storage directories
RUN mkdir -p /app/prisma /app/data /app/public/uploads

EXPOSE 3000

# Native Node.js healthcheck probe (zero external package dependency)
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e 'fetch("http://localhost:3000/api/health").then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))'

# Launch Next.js development server with auto-binding to 0.0.0.0
CMD ["sh", "-c", "npx prisma db push --skip-generate --accept-data-loss && npm run dev -- -H 0.0.0.0"]
