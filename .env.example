# ==============================================================================
# Dexta Africa Enterprise Operations Portal - Environment Configuration
# Copy this file to .env and configure values before starting the application
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration
# ------------------------------------------------------------------------------
# SQLite Default (Local & Embedded Container deployment):
DATABASE_URL="file:./prisma/admin_portal.db"

# PostgreSQL (Enterprise Cloud scale, e.g., Supabase / RDS / Neon):
# DATABASE_URL="postgresql://dexta_user:SecurePassword123!@localhost:5432/dexta_portal?schema=public"

# Database Automation Hooks (Container Startup)
AUTO_MIGRATE="true"
AUTO_SEED="true"

# ------------------------------------------------------------------------------
# 2. Application Core & Security
# ------------------------------------------------------------------------------
# Unique 64+ char cryptographic secret used for signing session tokens and MFA challenges
APP_SECRET="replace_with_a_cryptographically_secure_random_64_character_string"
PORTAL_NAME="Dexta Africa Operations Portal"
PORT=3000
HOSTNAME="0.0.0.0"
NODE_ENV="production"

# Initial Super Administrator (provisioned on initial seed)
INITIAL_ADMIN_EMAIL="admin@dextaafrica.com"
INITIAL_ADMIN_PASSWORD="AdminPassword2026!"
INITIAL_ADMIN_NAME="Dexta Super Admin"
ADMIN_REGISTRATION_PASSCODE="DEXTA-2026"

# ------------------------------------------------------------------------------
# 3. AWS S3 Cloud Storage & Media Vault
# ------------------------------------------------------------------------------
# For AWS Production S3:
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="AKIA_YOUR_AWS_ACCESS_KEY_HERE"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY_HERE"
AWS_S3_BUCKET_NAME="dexta-assets-storage"

# For Local Offline Testing with Docker MinIO (leave empty for AWS production):
# AWS_ENDPOINT="http://localhost:9000"
# AWS_S3_FORCE_PATH_STYLE="true"

# ------------------------------------------------------------------------------
# 4. Email Marketing & Notification Engine (SMTP / Resend)
# ------------------------------------------------------------------------------
EMAIL_FROM="Dexta Operations <operations@dextaafrica.com>"

# Resend API Service:
RESEND_API_KEY=""

# Or Standard SMTP (AWS SES, SendGrid, Mailgun, Brevo):
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS=""

# For Local Testing with Docker Mailpit:
# SMTP_HOST="localhost"
# SMTP_PORT=1025

