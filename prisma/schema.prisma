generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                   @id @default(uuid())
  email               String                   @unique
  passwordHash        String
  fullName            String
  role                String                   @default("ADMIN") // SUPER_ADMIN, ADMIN, HR_MANAGER, IT_ADMIN, OPERATIONS, AUDITOR
  department          String                   @default("OPERATIONS") // HR, IT, OPERATIONS, EXECUTIVE, FINANCE, ARCHITECTURE
  seniorityLevel      String                   @default("SENIOR") // EXECUTIVE, SENIOR, MID, JUNIOR
  jobTitle            String?
  phone               String?
  avatarUrl           String?
  bio                 String?
  status              String                   @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_APPROVAL
  twoFactorEnabled    Boolean                  @default(false)
  twoFactorSecret     String?
  mustChangePassword  Boolean                  @default(false)
  activationKey       String?
  lastLoginAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  sessions            Session[]
  recoveryCodes       TwoFactorRecoveryCode[]
  auditLogs           AuditLog[]               @relation("ActorAuditLogs")
  uploadedAssets      StorageAsset[]
  createdCampaigns    EmailCampaign[]
  employeeProfile     EmployeeProfile?
  leaveRequests       LeaveRequest[]           @relation("StaffLeaveRequests")
  approvedLeaves      LeaveRequest[]           @relation("ApprovedLeaves")
  credentialRequests  CredentialRequest[]      @relation("UserCredentialRequests")
  reviewedCredentials CredentialRequest[]      @relation("ItProcessedRequests")
  crmActivities       CrmActivity[]
}

model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  isUsed    Boolean   @default(false)
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([sessionToken])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorEmail String?
  actor      User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action     String   // AUTH_LOGIN, MFA_ENROLLED, HR_LEAVE_APPROVED, IT_CREDENTIAL_GRANTED, etc.
  entity     String   // User, EmployeeProfile, LeaveRequest, CredentialRequest, CrmClient
  entityId   String?
  ipAddress  String?
  userAgent  String?
  metadata   String?  // JSON stringified details
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([createdAt])
  @@index([actorId])
}

model StorageAsset {
  id           String   @id @default(uuid())
  bucket       String
  key          String   @unique
  fileName     String
  fileSize     Int
  mimeType     String
  url          String
  folder       String   @default("general")
  uploadedById String?
  uploader     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folder])
  @@index([createdAt])
}

model EmailCampaign {
  id             String    @id @default(uuid())
  title          String
  subject        String
  contentHtml    String
  status         String    @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT, FAILED
  recipientCount Int       @default(0)
  openCount      Int       @default(0)
  clickCount     Int       @default(0)
  sentAt         DateTime?
  createdById    String?
  creator        User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model EmailTemplate {
  id          String   @id @default(uuid())
  name        String
  subject     String
  bodyHtml    String
  variables   String   @default("[]") // JSON string of available tokens
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AudienceSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  firstName String?
  lastName  String?
  phone     String?
  company   String?
  category  String   @default("NEWSLETTER") // CLIENT, INVESTOR, PARTNER, CONTRACTOR, LEAD, NEWSLETTER
  notes     String?
  status    String   @default("SUBSCRIBED") // SUBSCRIBED, UNSUBSCRIBED, BOUNCED
  tags      String   @default("[]") // JSON string of tags
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model ApiEndpoint {
  id           String    @id @default(uuid())
  name         String
  baseUrl      String
  authType     String    @default("BEARER") // NONE, BEARER, API_KEY, HMAC
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE
  healthStatus String    @default("UNKNOWN") // HEALTHY, DEGRADED, DOWN, UNKNOWN
  lastLatencyMs Int?
  lastPingAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Webhook {
  id              String    @id @default(uuid())
  url             String
  secret          String
  events          String    @default("[\"*\"]") // JSON list of events
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// =============================================================================
// HR DEPARTMENT WORKSPACE & EMPLOYEE CRM
// =============================================================================

model EmployeeProfile {
  id                 String             @id @default(uuid())
  userId             String?            @unique
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeNumber     String             @unique // e.g. "DXT-104"
  fullName           String
  workEmail          String             @unique
  personalEmail      String?
  phone              String
  department         String             // "Executive", "Engineering", "Architecture", "Operations", "Finance", "Legal", "Human Resources", "IT"
  jobTitle           String
  employmentType     String             @default("FULL_TIME") // "FULL_TIME", "CONTRACT", "EXECUTIVE", "INTERN"
  status             String             @default("ACTIVE") // "ACTIVE", "ONBOARDING", "ON_LEAVE", "PROBATION", "OFFBOARDING"
  startDate          DateTime
  endDate            DateTime?
  managerName        String?
  location           String             @default("Lagos, Nigeria")
  emergencyContact   String?
  annualLeaveBalance Int                @default(20)
  usedLeaveDays      Int                @default(0)
  compensation       String?            // Optional encrypted or formatted salary tier / grade
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  documents          EmployeeDocument[]

  @@index([department])
  @@index([status])
}

model EmployeeDocument {
  id          String          @id @default(uuid())
  employeeId  String
  employee    EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title       String
  category    String          // "CONTRACT", "IDENTITY_PASSPORT", "TAX_PENSION", "CERTIFICATION", "NDA", "PERFORMANCE"
  fileUrl     String
  fileSize    Int             @default(0)
  mimeType    String          @default("application/pdf")
  verified    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([employeeId])
  @@index([category])
}

model LeaveRequest {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation("StaffLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  employeeName  String
  department    String
  leaveType     String    // "ANNUAL", "SICK", "MATERNITY", "PATERNITY", "COMPASSIONATE", "STUDY"
  startDate     DateTime
  endDate       DateTime
  daysCount     Int
  reason        String
  handoverNotes String?
  status        String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "CANCELLED"
  reviewedById  String?
  reviewedBy    User?     @relation("ApprovedLeaves", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewerNotes String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([userId])
}

// =============================================================================
// IT DEPARTMENT WORKSPACE & ACCESS GOVERNANCE
// =============================================================================

model CredentialRequest {
  id              String    @id @default(uuid())
  ticketNumber    String    @unique // e.g. "SEC-2026-7841"
  userId          String?
  user            User?     @relation("UserCredentialRequests", fields: [userId], references: [id], onDelete: Cascade)
  requesterEmail  String
  requesterName   String
  department      String    @default("GENERAL")
  requestType     String    // "PASSWORD_RESET", "ACCOUNT_PROVISION", "MFA_RESET", "ROLE_ELEVATION"
  status          String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "FULFILLED"
  priority        String    @default("MEDIUM") // "LOW", "MEDIUM", "HIGH", "URGENT"
  reason          String
  temporaryCode   String?   // Secure temporary OTP or verification code issued by IT
  ipAddress       String?
  userAgent       String?
  itNotes         String?
  reviewedById    String?
  reviewedBy      User?     @relation("ItProcessedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([requestType])
}

// =============================================================================
// CLIENT RELATIONSHIP & DEAL PIPELINE CRM
// =============================================================================

model CrmClient {
  id             String        @id @default(uuid())
  name           String
  company        String?
  email          String        @unique
  phone          String?
  category       String        @default("PROSPECT") // "PROSPECT", "ACTIVE_CLIENT", "INVESTOR", "STRATEGIC_PARTNER", "VENDOR"
  stage          String        @default("INQUIRY") // "INQUIRY", "DISCOVERY", "PROPOSAL_SENT", "NEGOTIATION", "CONTRACT_SIGNED", "ACTIVE_ACCOUNT"
  estimatedValue Float         @default(0)
  currency       String        @default("USD")
  assignedTo     String?
  location       String?       @default("Lagos, Nigeria")
  tags           String        @default("[]") // JSON string list
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deals          CrmDeal[]
  activities     CrmActivity[]

  @@index([stage])
  @@index([category])
}

model CrmDeal {
  id                 String    @id @default(uuid())
  clientId           String
  client             CrmClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title              String
  value              Float
  currency           String    @default("USD")
  stage              String    @default("PROPOSAL") // "PROPOSAL", "DUE_DILIGENCE", "CLOSING", "WON", "LOST"
  probability        Int       @default(60)
  expectedCloseDate  DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([clientId])
}

model CrmActivity {
  id           String     @id @default(uuid())
  clientId     String?
  client       CrmClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  type         String     // "CALL", "MEETING", "EMAIL", "CONTRACT_MEMO", "TASK", "MILESTONE"
  title        String
  description  String?
  outcome      String?
  activityDate DateTime   @default(now())
  createdAt    DateTime   @default(now())

  @@index([clientId])
}

// =============================================================================
// ENTERPRISE POLICY VIOLATIONS & SECURITY ALERTS
// =============================================================================

model PolicyAlert {
  id              String    @id @default(uuid())
  severity        String    @default("WARNING") // "INFO", "WARNING", "CRITICAL", "BREACH_ATTEMPT"
  eventType       String    // "UNAUTHORIZED_DASHBOARD_ACCESS", "POLICY_VIOLATION", "SUSPICIOUS_ACTIVITY", "CREDENTIAL_ABUSE"
  title           String
  description     String
  actorEmail      String?
  targetResource  String?
  ipAddress       String?
  userAgent       String?
  status          String    @default("OPEN") // "OPEN", "INVESTIGATING", "RESOLVED", "DISMISSED"
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

// =============================================================================
// INTER-DEPARTMENT APPROVALS & WORKFLOW AUTOMATION
// =============================================================================

model InterDeptApproval {
  id              String    @id @default(uuid())
  ticketNumber    String    @unique // e.g., "APR-2026-1042"
  title           String
  description     String
  category        String    // "BUDGET_DISBURSEMENT", "PROCUREMENT_LOGISTICS", "HEADCOUNT_HIRE", "CONTRACTOR_CLEARANCE", "TRAVEL_EXPENSE", "POLICY_EXCEPTION"
  fromDepartment  String    // "HR", "OPERATIONS", "FINANCE", "IT", "EXECUTIVE"
  toDepartment    String    // "OPERATIONS", "FINANCE", "EXECUTIVE", "HR", "IT"
  requesterId     String?
  requesterName   String
  requesterEmail  String
  priority        String    @default("NORMAL") // "LOW", "NORMAL", "HIGH", "URGENT"
  status          String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "CANCELLED"
  amount          Float?
  currency        String    @default("USD")
  approvedById    String?
  approvedByName  String?
  decisionNotes   String?
  decidedAt       DateTime?
  metadata        String?   // JSON stringified details
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([fromDepartment])
  @@index([toDepartment])
  @@index([createdAt])
}

model DashboardNotification {
  id          String    @id @default(uuid())
  userId      String?   // Null means department-wide or all broadcast
  department  String    @default("ALL") // "HR", "OPERATIONS", "FINANCE", "IT", "EXECUTIVE", "ALL"
  title       String
  message     String
  type        String    @default("SYSTEM_ALERT") // "APPROVAL_REQUEST", "APPROVAL_GRANTED", "APPROVAL_REJECTED", "EMAIL_RECEIVED", "TRANSACTION", "SECURITY_ALERT"
  link        String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  metadata    String?   // JSON string
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([department])
  @@index([isRead])
  @@index([createdAt])
}

model CorporateEmail {
  id             String    @id @default(uuid())
  threadId       String?
  direction      String    @default("OUTBOUND") // "OUTBOUND", "INBOUND", "INTERNAL"
  fromEmail      String
  fromName       String
  fromDepartment String    @default("OPERATIONS")
  toEmail        String
  toName         String
  toDepartment   String?
  cc             String?
  subject        String
  bodyHtml       String
  status         String    @default("SENT") // "SENT", "DELIVERED", "FAILED", "QUEUED"
  smtpMessageId  String?
  category       String    @default("OPERATIONS") // "OPERATIONS", "APPROVAL", "FINANCE", "HR", "EXECUTIVE", "GENERAL"
  createdAt      DateTime  @default(now())

  @@index([direction])
  @@index([fromDepartment])
  @@index([toDepartment])
  @@index([category])
  @@index([createdAt])
}

model FinancialTransaction {
  id                String    @id @default(uuid())
  reference         String    @unique // e.g. "TXN-2026-8921"
  type              String    // "CAPITAL_INFLOW", "PROJECT_DISBURSEMENT", "CONTRACTOR_PAYOUT", "PAYROLL", "TREASURY_TRANSFER", "ESCROW"
  title             String
  description       String?
  amount            Float
  currency          String    @default("USD")
  department        String    @default("TREASURY") // "OPERATIONS", "FINANCE", "HR", "IT", "EXECUTIVE"
  status            String    @default("SETTLED") // "SETTLED", "PENDING_APPROVAL", "RECONCILED", "FLAGGED"
  recipientOrEntity String
  authorizedBy      String
  approvedBy        String?
  transactionDate   DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([type])
  @@index([department])
  @@index([status])
  @@index([transactionDate])
}

model WorkflowAutomationRule {
  id              String    @id @default(uuid())
  name            String
  triggerEvent    String    // "APPROVAL_CREATED", "APPROVAL_GRANTED", "APPROVAL_REJECTED", "EMAIL_RECEIVED", "TRANSACTION_SETTLED"
  conditions      String?   // JSON criteria
  actionType      String    // "EMAIL_NOTIFICATION", "DASHBOARD_ALERT", "TREASURY_LEDGER_POST", "MULTI_NOTIFY"
  isEnabled       Boolean   @default(true)
  executionCount  Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([triggerEvent])
  @@index([isEnabled])
}

// =============================================================================
// EXECUTIVE CORPORATE REPORTS & DOCUMENT STUDIO
// =============================================================================

model ReportDocument {
  id               String    @id @default(uuid())
  reference        String    @unique // e.g. "RPT-OPS-2026-001"
  title            String
  cadence          String    @default("DAILY") // "DAILY", "WEEKLY", "MONTHLY", "AD_HOC"
  department       String    @default("OPERATIONS")
  authorName       String
  authorTitle      String?
  authorEmail      String
  lineManagerName  String?
  lineManagerTitle String?
  status           String    @default("DRAFT") // "DRAFT", "SUBMITTED", "APPROVED", "CHANGES_REQUESTED"
  reportDate       DateTime  @default(now())
  summary          String?
  sections         String?   // JSON array of narrative text sections
  spreadsheetData  String?   // JSON array of Excel-like spreadsheet rows & metrics
  images           String?   // JSON array of image attachments (data URL, caption, timestamp)
  managerNotes     String?
  metadata         String?   // JSON configuration
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([department])
  @@index([status])
  @@index([reportDate])
  @@index([createdAt])
}

// =============================================================================
// OPERATIONS INFRASTRUCTURE PROJECTS & GROUND MILESTONES
// =============================================================================

model InfrastructureProject {
  id             String    @id @default(uuid())
  code           String    @unique // e.g. "PRJ-LEK-001"
  name           String
  clientOrEntity String?
  location       String
  category       String    @default("INFRASTRUCTURE") // "INFRASTRUCTURE", "COMMERCIAL", "RESIDENTIAL", "MARINE_PORT", "INDUSTRIAL"
  status         String    @default("IN_PROGRESS") // "PLANNING", "IN_PROGRESS", "MILESTONE_INSPECTION", "COMPLETED", "ON_HOLD"
  progressPct    Int       @default(0)
  startDate      DateTime?
  targetEndDate  DateTime?
  leadEngineer   String?
  contractorTeam String?
  budget         Float?
  currency       String    @default("NGN")
  summary        String?
  milestones     String?   // JSON list of milestones
  images         String?   // JSON list of site photos
  createdByEmail String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([createdAt])
}

// =============================================================================
// CAREERS, VACANCIES & TALENT ACQUISITION WORKFLOW (HR <-> IT INTERACTION)
// =============================================================================

model CareerOpening {
  id                  String          @id @default(uuid())
  title               String
  slug                String          @unique
  department          String
  location            String
  type                String          @default("Full-Time")
  summary             String
  requirements        String          // JSON stringified string[]
  benefits            String          @default("[]") // JSON stringified string[]
  description         String?         // JSON stringified details
  status              String          @default("PENDING_IT_APPROVAL") // PENDING_IT_APPROVAL, OPEN, FILLED_PENDING_TAKEDOWN, CLOSED
  published           Boolean         @default(false)
  initiatedById       String?
  initiatedByName     String?
  initiatedByEmail    String?
  itApprovedById      String?
  itApprovedByName    String?
  itApprovedAt        DateTime?
  takedownRequestedAt DateTime?
  takedownNotes       String?
  takenDownById       String?
  takenDownByName     String?
  takenDownAt         DateTime?
  applicantClickCount Int             @default(0)
  inquiries           CareerInquiry[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status])
  @@index([published])
  @@index([department])
  @@index([createdAt])
}

model CareerInquiry {
  id              String        @id @default(uuid())
  careerOpeningId String
  careerOpening   CareerOpening @relation(fields: [careerOpeningId], references: [id], onDelete: Cascade)
  applicantName   String
  applicantEmail  String
  applicantPhone  String?
  resumeUrl       String?
  coverLetter     String?
  source          String        @default("WEBSITE_CLICK") // WEBSITE_CLICK, APPLICATION_FORM, LINKEDIN
  createdAt       DateTime      @default(now())

  @@index([careerOpeningId])
  @@index([createdAt])
}

// =============================================================================
// CUSTOM FORMS, ONBOARDING & EVENT REGISTRATION PORTALS
// =============================================================================

model CustomForm {
  id                      String           @id @default(uuid())
  slug                    String           @unique
  title                   String
  description             String?          @default("")
  formType                String           @default("event") // "event", "onboarding", "partner", "survey"
  status                  String           @default("active") // "active", "closed", "draft"
  coverImageUrl           String?          @default("")
  eventDate               DateTime?
  eventLocation           String?          @default("")
  activeFrom              DateTime?        // Scheduled start date/time when form opens
  activeUntil             DateTime?        // Scheduled expiry date/time when form automatically closes
  fields                  String           @default("[]") // JSON stringified form fields
  metadata                String           @default("{}") // JSON stringified metadata/styling
  sendConfirmationEmail   Boolean          @default(true)
  confirmationSubject     String?          @default("")
  confirmationMessage     String?          @default("")
  consentNotice           String?          @default("I hereby consent to Dexta Africa collecting, storing, and processing my personal data strictly in accordance with NDPR & GDPR regulatory standards. I acknowledge this information will only be used for official enterprise communications and event coordination.")
  requireConsent          Boolean          @default(true)
  submissions             FormSubmission[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([slug])
  @@index([formType])
  @@index([status])
  @@index([createdAt])
}

model FormSubmission {
  id                  String     @id @default(uuid())
  formId              String
  form                CustomForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  fullName            String
  email               String
  phone               String?    @default("")
  company             String?    @default("")
  jobTitle            String?    @default("")
  category            String     @default("Attendee") // "Client", "Lead", "Investor", "Partner", "Attendee", "Contractor"
  attendanceMode      String     @default("in-person") // "in-person", "virtual"
  answers             String     @default("{}") // JSON stringified answers
  notes               String?    @default("")
  status              String     @default("registered") // "registered", "confirmed", "attended", "cancelled"
  consentAcknowledged Boolean    @default(true)
  consentTimestamp    DateTime?  @default(now())
  ipAddress           String?    @default("")
  userAgent           String?    @default("")
  createdAt           DateTime   @default(now())

  @@index([formId])
  @@index([email])
  @@index([category])
  @@index([createdAt])
}

// =============================================================================
// TWO-LEVEL PRODUCTION APPROVAL & GOVERNANCE PIPELINE
// =============================================================================

model ProductionReleaseRequest {
  id                String    @id @default(uuid())
  ticketNumber      String    @unique // e.g. "PRD-2026-9041"
  title             String
  description       String
  category          String    // "PROD_DEPLOYMENT", "POLICY_CHANGE", "ROLE_ELEVATION", "CONFIG_UPDATE", "CREDENTIAL_ISSUANCE"
  targetSystem      String    @default("PORTAL_CORE") // "PORTAL_CORE", "STORAGE_S3", "PAYMENT_GATEWAY", "API_ROUTER"
  adminId           String
  adminName         String
  adminEmail        String
  superAdminId      String?
  superAdminName    String?
  superAdminEmail   String?
  status            String    @default("PENDING_SUPER_ADMIN") // "PENDING_SUPER_ADMIN", "APPROVED_LIVE", "REJECTED", "CANCELLED"
  stage             Int       @default(1) // 1: Submitted by Admin, 2: Approved by Super Admin (Live)
  justification     String
  payloadDiff       String?   // JSON representation of change or config
  rejectionReason   String?
  scheduledFor      DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([adminId])
  @@index([superAdminId])
  @@index([createdAt])
}


